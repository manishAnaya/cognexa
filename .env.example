# Application
APP_NAME=Cognexa
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=

# Database
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/cognexa
JWT_SECRET_KEY=replace-with-a-private-secret-at-least-32-characters-long

# RAG model provider (required for chat)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Database
CHROMA_PERSIST_DIRECTORY=./chroma_db
